# ==============================================================================
# StockSense Environment Configuration Example
# Copy this file to .env and set your local SQL Server credentials.
# NEVER commit the .env file to Git!
# ==============================================================================

# Database Target: SQL Server (Docker on WSL2 / Localhost)
DB_SERVER=localhost,1433
DB_NAME=stocksense
DB_USER=stocksense_user
DB_PASSWORD=YourStrongPasswordHere

# Optional connection settings with defaults
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERT=yes
DB_CONNECTION_TIMEOUT=30

# Project Paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
